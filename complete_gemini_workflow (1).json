      "parameters": {
        "jsCode": "// Handle both direct Gemini output and AI Agent output\nlet data;\nlet sourceNode = '';\n\n// Check if this comes from AI Agent (backup processing)\nif ($('AI Agent (Backup)').length > 0 && $('AI Agent (Backup)').first().json.output) {\n  sourceNode = 'AI Agent (Backup)';\n  let outputStr = $('AI Agent (Backup)').first().json.output;\n  \n  let jsonMatch = outputStr.match(/({[\\s\\S]*})/);\n  if (!jsonMatch) {\n    throw new Error(\"No valid JSON found in AI Agent output!\");\n  }\n  \n  data = JSON.parse(jsonMatch[1]);\n} else {\n  // Direct from Gemini processing\n  sourceNode = 'Process Gemini Response';\n  data = $('Process Gemini Response').first().json;\n}\n\n// Ensure jsonnumber is set\nif (!data.jsonnumber) {\n  data.jsonnumber = $('Counter Node').first().json.number;\n}\n\nconsole.log(`Final data from ${sourceNode} for PDF ${data.jsonnumber}:`, JSON.stringify(data, null, 2));\n\nreturn [{ json: data }];"
      },
