      "parameters": {
        "jsCode": "// Process Google Gemini Vision response\nconst response = $input.first().json;\n\nconsole.log('Gemini Response:', JSON.stringify(response, null, 2));\n\n// Extract text from Gemini response\nlet extractedText = '';\nif (response.candidates && response.candidates[0] && response.candidates[0].content && response.candidates[0].content.parts) {\n  extractedText = response.candidates[0].content.parts[0].text || '';\n} else {\n  return {\n    json: {\n      error: true,\n      message: 'No valid response from Gemini Vision',\n      response: response\n    }\n  };\n}\n\nconsole.log('Extracted text:', extractedText);\n\n// Try to parse JSON directly from response\nlet jsonMatch = extractedText.match(/({[\\s\\S]*})/);\n\nif (jsonMatch) {\n  try {\n    let parsedData = JSON.parse(jsonMatch[1]);\n    \n    // Add jsonnumber if missing\n    if (!parsedData.jsonnumber) {\n      parsedData.jsonnumber = $('Counter Node').first().json.number;\n    }\n    \n    console.log('Successfully parsed JSON:', JSON.stringify(parsedData, null, 2));\n    \n    return {\n      json: parsedData\n    };\n  } catch (parseError) {\n    console.error('JSON parsing error:', parseError);\n  }\n}\n\n// If direct parsing fails, return the text for AI processing\nreturn {\n  json: {\n    textChunks: [extractedText],\n    needsAIProcessing: true\n  }\n};"
      },
