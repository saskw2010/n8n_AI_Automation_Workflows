      "id": "3eb1e0f2-5213-4c21-8358-74489bc0af2f"
    },
    {
      "parameters": {
        "jsCode": "const ocrResult = $('OCR.space API').first().json;\n\nif (!ocrResult.ParsedResults || ocrResult.ParsedResults.length === 0) {\n  return {\n    json: {\n      error: true,\n      message: 'No ParsedResults returned from OCR.'\n    }\n  };\n}\n\n// 1. دمج النصوص من كل صفحات OCR\nlet fullText = ocrResult.ParsedResults\n  .map(p => p.ParsedText || '')\n  .join('\\n\\n');\n\n// 2. تنظيف النص\nconst cleanedText = fullText\n  .replace(/\\r\\n/g, '\\n')\n  .replace(/[ \\t]{2,}/g, ' ')        // حذف المسافات الزائدة\n  .replace(/\\n\\s*\\n/g, '\\n\\n')       // حذف الأسطر الفارغة المتكررة\n  .trim();\n\n// 3. تقسيم النص إلى أجزاء صغيرة (4000 حرف كحد أقصى للذكاء الاصطناعي)\nconst chunkSize = 4000;\nconst chunks = [];\n\nfor (let i = 0; i < cleanedText.length; i += chunkSize) {\n  chunks.push(cleanedText.slice(i, i + chunkSize));\n}\n\n// 4. إرجاع الناتج\nreturn {\n  json: {\n    ocrExitCode: ocrResult.OCRExitCode,\n    processingTime: ocrResult.ProcessingTimeInMilliseconds,\n    originalText: fullText,\n    cleanedText: cleanedText,\n    textChunks: chunks\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        60
      ],
      "id": "584d709d-ad0f-4ea8-b9c4-6abba8a9c365",
      "name": "Clean code"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Extract the following fields from the provided Arabic text chunk and return them in a flat JSON object. Do not include any nested arrays or objects. Join multiple values in arrays using \" | \" for inner values and \";\" for separating entries. Ensure all fields appear in the output, even if their values are empty. All values must be strings or numbers only.\n\nFields to extract:\n\nID_الوثيقة\n\nنوع_الوثيقة\n\nالمصدر\n\nالتاريخ\n\nالمرخص_له\n\nالجهة_المانحة (in format: \"الإدارة المختصة- [اسم الإدارة] : [المحافظة]\")\n\nرقم_الشاليه\n\nالمنطقة_او_العنوان_التفصيلي (concatenate all related address fields separated by \" ; \")\n\nإجمالي_المساحة\n\nالمساحة_المكشوفة\n\nالمساحة_المسقوفة\n\nإجمالي_المساحة_المكشوفة_في_الأرض_الأصلية\n\nالتفاصيل_المالية (format: بند | قيمة | عملة)\n\nالمواصفات_التقنية (format: بند | قيمة | وحدة)\n\nالشروط_القانونية_الهامة (joined by semicolon)\n\nتحذيرات_ومخاطر (joined by semicolon)\n\nنقاط_الخلاصة_التنفيذية (joined by semicolon)\n\n\n\nReturn ONLY the JSON object. It must start with \"{\" and end with \"}\". Do not include any explanation, notes, or extra text.\n\nInput text:\n{{ $json.textChunks }} and  also add to data \n\"jsonnumber:\" {{ $('Counter Node').item.json.number }} \n",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.9,
      "position": [
        1020,
