    {
      "parameters": {
        "jsCode": "let outputStr = $input.first().json.output;\n\n// استخراج أول كود JSON - البحث عن object بدلاً من array\nlet jsonMatch = outputStr.match(/({[\\s\\S]*})/);\n\nif (!jsonMatch) {\n  throw new Error(\"No valid JSON found in the input!\");\n}\n\nlet jsonStr = jsonMatch[1];\n\n// تنفيذ الـ parse\nlet data = JSON.parse(jsonStr);\n\nreturn [{ json: data }];"
      },
