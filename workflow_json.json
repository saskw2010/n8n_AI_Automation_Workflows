      "parameters": {
        "jsCode": "// Get workflow context - Counter Node\nconst inputData = $input.all();\nlet currentNumber = 1;\n\n// Check if we have input from a loop\nif (inputData.length > 0 && inputData[0].json.number) {\n  currentNumber = inputData[0].json.number;\n}\n\nconsole.log(`Processing PDF number: ${currentNumber}`);\n\nreturn [{\n  json: {\n    number: currentNumber\n  }\n}];"
      },
