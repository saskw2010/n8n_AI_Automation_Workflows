      "parameters": {
        "jsCode": "// Get current number from Counter Node\nlet current = $('Counter Node').first().json.number;\n\nconsole.log(`Finished processing number: ${current}`);\n\n// Check if done\nif (current >= 9) {\n  console.log('All PDFs processed!');\n  return [{\n    json: {\n      finished: true,\n      message: `Completed processing PDFs 1-${current}`,\n      totalProcessed: current\n    }\n  }];\n}\n\n// Continue with next number\nlet next = current + 1;\nconsole.log(`Next PDF to process: ${next}`);\n\nreturn [{\n  json: {\n    number: next,\n    continue: true,\n    currentlyProcessed: current\n  }\n}];"
      },
