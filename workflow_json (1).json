      "parameters": {
        "jsCode": "let outputStr = $input.first().json.output;\n\n// استخراج أول كود JSON - البحث عن object بدلاً من array\nlet jsonMatch = outputStr.match(/({[\\s\\S]*})/);\n\nif (!jsonMatch) {\n  throw new Error(\"No valid JSON found in the input!\");\n}\n\nlet jsonStr = jsonMatch[1];\n\n// تنفيذ الـ parse\nlet data = JSON.parse(jsonStr);\n\n// إضافة رقم الـ PDF من Counter Node إذا لم يكن موجوداً\nif (!data.jsonnumber) {\n  data.jsonnumber = $('Counter Node').first().json.number;\n}\n\nconsole.log(`Parsed data for PDF ${data.jsonnumber}:`, JSON.stringify(data, null, 2));\n\nreturn [{ json: data }];"
      },
