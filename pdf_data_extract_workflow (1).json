      "parameters": {
        "jsCode": "// معالجة الأخطاء العامة\nconst errorData = $input.first();\n\nlet errorMessage = 'حدث خطأ في معالجة PDF';\nlet errorType = 'GENERAL_ERROR';\nlet suggestions = [];\n\nif (errorData && errorData.error) {\n  errorMessage = errorData.error;\n  \n  if (errorMessage.includes('PDF')) {\n    errorType = 'PDF_ERROR';\n    suggestions = [\n      'تأكد من أن الملف PDF صالح وغير تالف',\n      'جرب ملف PDF آخر',\n      'تأكد من أن PDF غير محمي بكلمة مرور',\n      'اختر ملف أصغر حجماً (أقل من 100MB)'\n    ];\n  } else if (errorMessage.includes('حجم الملف')) {\n    errorType = 'FILE_SIZE_ERROR';\n    suggestions = [\n      'قم بضغط ملف PDF',\n      'قسم الملف إلى أجزاء أصغر',\n      'استخدم ملف أقل من 100MB'\n    ];\n  } else if (errorMessage.includes('صفحات')) {\n    errorType = 'PAGE_EXTRACTION_ERROR';\n    suggestions = [\n      'تأكد من أن PDF يحتوي على نص قابل للاستخراج',\n      'إذا كان PDF يحتوي على صور، استخدم OCR',\n      'جرب PDF من مصدر آخر'\n    ];\n  } else {\n    suggestions = [\n      'جرب إعادة رفع الملف',\n      'تحقق من اتصال الإنترنت',\n      'راجع تنسيق الملف',\n      'تواصل مع الدعم التقني'\n    ];\n  }\n}\n\nconsole.log(`خطأ في workflow: ${errorType} - ${errorMessage}`);\n\nreturn {\n  success: false,\n  errorType: errorType,\n  error: errorMessage,\n  suggestions: suggestions,\n  timestamp: new Date().toISOString(),\n  workflowStep: 'معالجة الملف',\n  nextActions: [\n    'راجع الخطأ والاقتراحات أعلاه',\n    'تأكد من صحة الملف والإعدادات',\n    'جرب مرة أخرى بملف مختلف'\n  ]\n};"
      },
