    {
      "parameters": {
        "jsCode": "// تحضير تقرير النجاح النهائي\nconst sheetResult = $input.first();\nconst tableData = $('prepare-table-rows').first().json;\nconst fileInfo = $('validate-pdf').first().json;\n\nconst totalPages = Array.isArray(tableData) ? tableData.length - 1 : 0; // -1 لأن آخر صف هو الملخص\nconst totalWords = Array.isArray(tableData) && tableData.length > 0 ? \n  tableData.slice(0, -1).reduce((sum, row) => sum + (row['عدد الكلمات'] || 0), 0) : 0;\nconst averageQuality = Array.isArray(tableData) && tableData.length > 1 ? \n  Math.round(tableData.slice(0, -1).reduce((sum, row) => sum + (row['جودة الصفحة (%)'] || 0), 0) / (tableData.length - 1)) : 0;\n\nconst finalReport = {\n  success: true,\n  message: 'تم إنشاء Google Sheet بنجاح مع جميع صفحات PDF',\n  fileInfo: {\n    fileName: fileInfo.fileName,\n    fileSize: fileInfo.fileSizeKB + ' KB',\n    processingId: fileInfo.processingId,\n    uploadTime: fileInfo.uploadTime\n  },\n  processingResults: {\n    totalPagesProcessed: totalPages,\n    totalWordsExtracted: totalWords,\n    averagePageQuality: averageQuality + '%',\n    processingTime: new Date().toISOString()\n  },\n  googleSheet: {\n    spreadsheetId: sheetResult.json.spreadsheetId,\n    sheetUrl: sheetResult.json.spreadsheetUrl,\n    sheetName: 'Extracted_Pages_Data',\n    totalRows: Array.isArray(tableData) ? tableData.length : 0,\n    columns: [\n      'رقم الصفحة', 'نوع المحتوى', 'عدد الكلمات', 'عدد الأحرف',\n      'اللغة الأساسية', 'جودة الصفحة (%)', 'البريد الإلكتروني',\n      'أرقام الهاتف', 'التواريخ', 'الأرقام المهمة', 'الكلمات المفتاحية',\n      'ملخص المحتوى', 'النص الكامل', 'اسم الملف', 'تاريخ المعالجة',\n      'وقت المعالجة', 'معرف المعالجة'\n    ]\n  },\n  dataAnalysis: {\n    pagesWithContent: totalPages,\n    emptyPages: 0,\n    predominantLanguage: averageQuality > 70 ? 'جودة عالية' : averageQuality > 50 ? 'جودة متوسطة' : 'جودة منخفضة',\n    extractedEmails: Array.isArray(tableData) ? [...new Set(tableData.map(row => row['البريد الإلكتروني']).filter(e => e && e !== 'لا يوجد'))].length : 0,\n    extractedPhones: Array.isArray(tableData) ? [...new Set(tableData.map(row => row['أرقام الهاتف']).filter(p => p && p !== 'لا يوجد'))].length : 0\n  },\n  nextSteps: [\n    `افتح الجدول على: ${sheetResult.json.spreadsheetUrl}`,\n    'راجع البيانات المستخرجة في العمود \"النص الكامل\"',\n    'استخدم فلاتر الجدول لتصنيف البيانات',\n    'يمكنك تصدير البيانات لتطبيقات أخرى',\n    'استخدم البحث في الجدول للعثور على معلومات محددة'\n  ],\n  tips: [\n    'كل صف يمثل صفحة واحدة من PDF',\n    'الصف الأخير يحتوي على ملخص إجمالي',\n    'استخدم عمود \"نوع المحتوى\" لتصنيف الصفحات',\n    'عمود \"جودة الصفحة\" يوضح مدى نجاح استخراج النص'\n  ]\n};\n\nconsole.log('تم إكمال معالجة PDF بنجاح:', {\n  pages: totalPages,\n  words: totalWords,\n  sheetId: sheetResult.json.spreadsheetId\n});\n\nreturn finalReport;"
      },
      "id": "success-final-report",
      "name": "Success Final Report",
      "type": "n8n-nodes-base.code",
